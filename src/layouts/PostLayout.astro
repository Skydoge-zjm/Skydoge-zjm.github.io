---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tag from '../components/Tag.astro';
import Giscus from '../components/Giscus.astro';
import { readingTime, type Post } from '../lib/utils';

interface Props {
  post: Post;
  /** render() 返回的标题锚点列表 */
  headings: { depth: number; slug: string; text: string }[];
  prev?: Post;
  next?: Post;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = readingTime(post.body ?? '');
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  searchable
>
  <article class="mx-auto max-w-3xl px-5 pb-4 pt-12">
    <header>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-fg-faint">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span class="font-mono text-xs">约 {minutes} 分钟</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span class="font-mono text-xs">
                更新于 {updatedDate.getFullYear()}-
                {String(updatedDate.getMonth() + 1).padStart(2, '0')}-
                {String(updatedDate.getDate()).padStart(2, '0')}
              </span>
            </>
          )
        }
      </div>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-[2.1rem] sm:leading-tight">
        {title}
      </h1>
      <p class="mt-4 leading-relaxed text-fg-muted">{description}</p>
      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    <div class="mt-10 border-t border-border pt-10">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>

  {
    (prev || next) && (
      <nav
        class="mx-auto max-w-3xl px-5 py-10"
        aria-label="上一篇 / 下一篇"
      >
        <div class="grid gap-5 border-t border-border pt-8 sm:grid-cols-2">
          {prev ? (
            <a href={`/blog/${prev.id}/`} class="group block">
              <p class="font-mono text-xs text-fg-faint">← 上一篇</p>
              <p class="mt-1.5 line-clamp-1 text-sm font-medium transition-colors group-hover:text-accent">
                {prev.data.title}
              </p>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/blog/${next.id}/`}
              class="group block sm:text-right"
            >
              <p class="font-mono text-xs text-fg-faint">下一篇 →</p>
              <p class="mt-1.5 line-clamp-1 text-sm font-medium transition-colors group-hover:text-accent">
                {next.data.title}
              </p>
            </a>
          ) : (
            <span />
          )}
        </div>
      </nav>
    )
  }

  <div class="mx-auto max-w-3xl px-5 pb-16">
    <Giscus />
  </div>

  <!-- 桌面端浮动目录 -->
  {
    toc.length >= 3 && (
      <aside
        class="pointer-events-none fixed top-24 left-1/2 z-30 ml-[26rem] hidden w-52 xl:block"
        aria-label="目录"
      >
        <p class="font-mono text-xs uppercase tracking-widest text-fg-faint">
          目录
        </p>
        <ul class="pointer-events-auto mt-3 space-y-1 border-l border-border">
          {toc.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link
                class:list={[
                  '-ml-px block border-l py-1 text-xs leading-snug transition-colors',
                  h.depth === 3 ? 'pl-6 text-fg-faint' : 'pl-3 text-fg-muted',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</BaseLayout>

<script>
  // 代码块复制按钮
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = '复制';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      try {
        await navigator.clipboard.writeText(code?.innerText ?? '');
        button.textContent = '已复制';
      } catch {
        button.textContent = '复制失败';
      }
      window.setTimeout(() => (button.textContent = '复制'), 1600);
    });
    pre.appendChild(button);
  });

  // 目录高亮当前小节
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length > 0) {
    const map = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.getAttribute('href')?.slice(1);
      if (id) map.set(id, link);
    }
    const headings = [...map.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const activate = (id: string) => {
      for (const [key, link] of map) {
        const active = key === id;
        link.style.color = active ? 'var(--accent)' : '';
        link.style.borderColor = active ? 'var(--accent)' : '';
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) activate(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
