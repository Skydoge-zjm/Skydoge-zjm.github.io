---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  /** 页面标题（不含站点名） */
  title?: string;
  description?: string;
  /** OG 类型，文章页传 article */
  ogType?: 'website' | 'article';
  /** 不索引此页 */
  noindex?: boolean;
  /** 是否允许被站内搜索索引（只有文章页需要） */
  searchable?: boolean;
  /** 页面结构化数据，如 BlogPosting */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  noindex = false,
  searchable = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const jsonLdText = jsonLd
  ? JSON.stringify(jsonLd)
      .replaceAll('<', '\\u003c')
      .replaceAll('>', '\\u003e')
      .replaceAll('&', '\\u0026')
  : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText}></script>}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />

    <!-- 主题初始化：在首屏渲染前确定亮/暗，避免闪白 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <div class="shell">
      <Sidebar />
      <div class="content" data-pagefind-ignore={searchable ? undefined : ''}>
        <main class="page-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <div id="site-tooltip" class="site-tooltip" role="tooltip" aria-hidden="true" data-placement="top"></div>

<script is:inline>
  (() => {
    const tooltip = document.getElementById('site-tooltip');
    if (!tooltip) return;

    let hoveredTarget = null;
    let focusedTarget = null;
    let currentTarget = null;
    let describedTarget = null;

    const setDescription = (target, enabled) => {
      if (!(target instanceof HTMLElement)) return;
      const ids = (target.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean);
      const next = enabled
        ? [...new Set([...ids, tooltip.id])]
        : ids.filter((id) => id !== tooltip.id);
      if (next.length) target.setAttribute('aria-describedby', next.join(' '));
      else target.removeAttribute('aria-describedby');
    };

    const position = (target) => {
      const margin = 8;
      const gap = 9;
      const rect = target.getBoundingClientRect();
      const viewportWidth = document.documentElement.clientWidth;
      const viewportHeight = window.innerHeight;

      tooltip.style.left = '0px';
      tooltip.style.top = '0px';
      const tip = tooltip.getBoundingClientRect();
      const left = Math.max(margin, Math.min(
        rect.left + (rect.width - tip.width) / 2,
        viewportWidth - tip.width - margin,
      ));
      const arrowX = Math.max(10, Math.min(rect.left + rect.width / 2 - left, tip.width - 10));
      let placement = target.dataset.tooltipPlacement === 'bottom' ? 'bottom' : 'top';
      let top = placement === 'bottom' ? rect.bottom + gap : rect.top - tip.height - gap;

      if (placement === 'top' && top < margin) {
        placement = 'bottom';
        top = rect.bottom + gap;
      } else if (placement === 'bottom' && top + tip.height > viewportHeight - margin) {
        placement = 'top';
        top = rect.top - tip.height - gap;
      }

      if (rect.bottom < 0 || rect.top > viewportHeight) {
        tooltip.dataset.visible = 'false';
        return;
      }

      tooltip.dataset.placement = placement;
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${Math.max(margin, Math.min(top, viewportHeight - tip.height - margin))}px`;
      tooltip.style.setProperty('--tooltip-arrow-x', `${arrowX}px`);
      tooltip.dataset.visible = 'true';
    };

    const update = () => {
      const target = focusedTarget || hoveredTarget;
      if (describedTarget !== focusedTarget) {
        if (describedTarget) setDescription(describedTarget, false);
        if (focusedTarget) setDescription(focusedTarget, true);
        describedTarget = focusedTarget;
      }

      if (!target || !target.dataset.tooltip?.trim()) {
        currentTarget = null;
        tooltip.dataset.visible = 'false';
        tooltip.setAttribute('aria-hidden', 'true');
        return;
      }

      tooltip.textContent = target.dataset.tooltip.trim();
      tooltip.setAttribute('aria-hidden', 'false');
      currentTarget = target;
      position(target);
    };

    const tooltipTarget = (target) => target instanceof Element
      ? target.closest('[data-tooltip]')
      : null;
    const relatedTargetIsInside = (target, relatedTarget) =>
      relatedTarget instanceof Node && target.contains(relatedTarget);

    document.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const target = tooltipTarget(event.target);
      if (!target || target === hoveredTarget) return;
      hoveredTarget = target;
      update();
    });
    document.addEventListener('pointerout', (event) => {
      const target = tooltipTarget(event.target);
      if (!target || target !== hoveredTarget || relatedTargetIsInside(target, event.relatedTarget)) return;
      hoveredTarget = null;
      update();
    });
    document.addEventListener('focusin', (event) => {
      focusedTarget = tooltipTarget(event.target);
      update();
    });
    document.addEventListener('focusout', (event) => {
      const target = tooltipTarget(event.target);
      if (!target || target !== focusedTarget || relatedTargetIsInside(target, event.relatedTarget)) return;
      focusedTarget = null;
      update();
    });
    document.addEventListener('click', (event) => {
      const target = tooltipTarget(event.target);
      if (target && target === currentTarget) requestAnimationFrame(update);
    });
    window.addEventListener('resize', () => currentTarget && position(currentTarget), { passive: true });
    window.addEventListener('scroll', () => currentTarget && position(currentTarget), { capture: true, passive: true });
  })();
</script>
  </body>
</html>
