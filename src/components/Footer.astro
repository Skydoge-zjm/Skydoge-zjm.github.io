---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-border" data-pagefind-ignore>
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-3 px-5 py-8 text-xs text-fg-faint sm:flex-row sm:justify-between"
  >
    <p class="font-mono">
      © {year} {SITE.name} · 由 Astro 驱动
    </p>
    <div class="flex items-center gap-4">
      <a
        href={SITE.social.github}
        class="transition-colors hover:text-fg"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a href={`mailto:${SITE.social.email}`} class="transition-colors hover:text-fg">
        邮箱
      </a>
      <a href="/rss.xml" class="transition-colors hover:text-fg">RSS</a>
    </div>
  </div>
</footer>
