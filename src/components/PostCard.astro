---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 输出 data-tags 属性，供文章页客户端标签筛选使用 */
  filterable?: boolean;
}

const { post, filterable = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const date = `${pad(post.data.pubDate.getMonth() + 1)}-${pad(post.data.pubDate.getDate())}`;
---

<li class="ledger-row" data-tags={filterable ? post.data.tags.join(',') : undefined}>
  <span class="ledger-date">{date}</span>

  <a href={`/blog/${post.id}/`} class="ledger-title">
    {post.data.title}
    {
      post.data.pinned && (
        <span class="ledger-pin">置顶</span>
      )
    }
  </a>

  {
    post.data.tags.length > 0 && (
      <span class="ledger-tags">
        {post.data.tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </span>
    )
  }
</li>
