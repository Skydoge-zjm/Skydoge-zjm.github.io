---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import Category from './Category.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 输出分类和年份字段，供文章列表客户端筛选使用 */
  filterable?: boolean;
}

const { post, filterable = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const date = `${pad(post.data.pubDate.getMonth() + 1)}-${pad(post.data.pubDate.getDate())}`;
---

<li
  class="ledger-row"
  data-year={filterable ? String(post.data.pubDate.getFullYear()) : undefined}
  data-category={filterable ? post.data.category : undefined}
>
  <span class="ledger-date">{date}</span>
  <Category category={post.data.category} />

  <a href={`/blog/${post.id}/`} class="ledger-title">
    {post.data.title}
    {
      post.data.pinned && (
        <span class="ledger-pin">置顶</span>
      )
    }
  </a>

  {
    post.data.tags.length > 0 && (
      <span class="ledger-tags">
        {post.data.tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </span>
    )
  }
</li>
