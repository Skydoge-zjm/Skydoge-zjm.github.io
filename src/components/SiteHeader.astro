---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navigation = [{ text: '首页', href: '/' }, ...SITE.nav];
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} 首页`}>{SITE.name}</a>
    <nav class="site-nav" aria-label="主导航">
      {navigation.map(({ text, href }) => (
        <a href={href} aria-current={path === href ? 'page' : path.startsWith(href + '/') ? 'location' : undefined}>
          {text}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <a href="/search/" class="icon-btn" aria-label="搜索文章" aria-current={path === '/search' ? 'page' : undefined} data-tooltip="搜索文章" data-tooltip-placement="bottom">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="10.7" cy="10.7" r="6.8" />
          <path d="m16 16 4.6 4.6" />
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
