---
import { Image } from 'astro:assets';
import avatar from '../assets/skydoge-avatar.jpg';
import { PROJECTS } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="关于">
  <header class="page-head author-intro">
    <h1 class="page-title">关于</h1>
    <p class="author-bio">
      你好，我是 <strong>{SITE.name}</strong>。{SITE.description}
    </p>
    <Image
      src={avatar}
      alt={`${SITE.name} 的 GitHub 头像`}
      width={128}
      height={128}
      densities={[1, 2, 3]}
      loading="eager"
      class="author-avatar"
    />
  </header>

  <!-- ↓↓↓ 以下内容按需修改成你自己的介绍 ↓↓↓ -->
  <div class="prose">
    <h2>我在做什么</h2>
    <p>
      研究之余，我也写代码、做工具。相信「写下来」是理解一件事最便宜的方式，
      所以有了这个站。
    </p>

    <section aria-labelledby="products">
      <h2 id="products">我做的产品</h2>
      <dl class="product-list">
        {PROJECTS.map((project) => (
          <div>
            <dt><a href={project.href}>{project.name}</a></dt>
            <dd>
              {project.description}
              {project.source && <a class="product-source" href={project.source} aria-label={`${project.name} 源码`}>源码</a>}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <h2>联系我</h2>
    <ul>
      <li>
        GitHub：<a href={SITE.social.github}
          >{SITE.social.github.replace('https://', '')}</a
        >
      </li>
      <li>主要邮箱：<a href={`mailto:${SITE.social.email}`}>{SITE.social.email}</a></li>
      <li>备用邮箱（不常用）：<a href={`mailto:${SITE.social.backupEmail}`}>{SITE.social.backupEmail}</a></li>
    </ul>
  </div>
  <!-- ↑↑↑ 以上内容按需修改成你自己的介绍 ↑↑↑ -->
</BaseLayout>

<style>
  .author-intro {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) auto;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem clamp(1.25rem, 4vw, 3rem);
  }
  .author-bio {
    grid-column: 1;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.9;
  }
  .author-bio strong { color: var(--ink); }
  .author-avatar {
    grid-column: 2;
    grid-row: 1 / 3;
    width: clamp(5rem, 11vw, 8rem);
    height: auto;
    border-radius: 0.5rem;
  }
  .prose > h2:first-child { margin-top: 0; }
  .product-list { margin-top: 0.65rem; }
  .product-list > div {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.15rem 1.25rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }
  .product-list dt { font-weight: 600; }
  .product-list dd { color: var(--ink-2); font-size: 0.95rem; }
  .product-source { margin-inline-start: 0.5rem; font-size: 0.82rem; white-space: nowrap; }
  @media (max-width: 35rem) {
    .author-intro { row-gap: 1rem; }
    .author-avatar { grid-row: 1; }
    .author-bio { grid-column: 1 / -1; }
    .product-list > div { grid-template-columns: 1fr; }
  }
</style>
