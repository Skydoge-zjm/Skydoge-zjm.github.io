---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategoryCounts } from '../lib/utils';

const posts = await getPublishedPosts();
const categories = [...getCategoryCounts(posts).keys()];
---

<BaseLayout title="搜索" description="搜索全站文章" noindex>
  <div class="page-head">
    <h1 class="page-title">搜索</h1>
  </div>

  <div class="search-controls">
    <div class="relative min-w-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-fg-faint"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词…"
        autocomplete="off"
        class="field"
        aria-label="搜索文章"
      />
    </div>
    <div class="search-filter-label">
      <span id="search-category-label">分类</span>
      <div class="search-category-dropdown" data-category-dropdown>
        <button
          id="search-category"
          type="button"
          class="search-category-trigger"
          aria-label="按分类筛选，当前全部分类"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="search-category-options"
        >
          <span id="search-category-value">全部分类</span>
          <svg class="search-category-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 7.5 5 5 5-5"></path>
          </svg>
        </button>
        <div
          id="search-category-options"
          class="search-category-menu"
          role="listbox"
          aria-labelledby="search-category-label"
          hidden
        >
          <div class="search-category-option" role="option" tabindex="0" data-value="" data-label="全部分类" aria-selected="true">
            <span class="search-category-check" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 3.2 3.2L13 4.5"></path></svg>
            </span>
            <span>全部分类</span>
          </div>
          {categories.map((category) => (
            <div class="search-category-option" role="option" tabindex="-1" data-value={category} data-label={category} aria-selected="false">
              <span class="search-category-check" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 3.2 3.2L13 4.5"></path></svg>
              </span>
              <span>{category}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <p id="search-status" class="empty-note mt-5" role="status" aria-live="polite">输入关键词或选择分类开始搜索。</p>
  <ul id="search-results" class="ledger mt-3"></ul>
  <ul id="search-catalog" hidden data-pagefind-ignore>
    {posts.map((post) => (
      <li data-category={post.data.category}>
        <a href={`/blog/${post.id}/`} data-title={post.data.title} data-description={post.data.description}>
          {post.data.title}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<script type="module" is:inline>
  const input = document.getElementById('search-input');
  const categoryDropdown = document.querySelector('[data-category-dropdown]');
  const categoryTrigger = document.getElementById('search-category');
  const categoryMenu = document.getElementById('search-category-options');
  const categoryValue = document.getElementById('search-category-value');
  const categoryOptions = [...document.querySelectorAll('[data-category-dropdown] [data-value]')];
  const list = document.getElementById('search-results');
  const catalog = document.getElementById('search-catalog');
  const status = document.getElementById('search-status');

  if (input && categoryDropdown && categoryTrigger && categoryMenu && categoryValue && list && catalog && status) {
    let pagefind = null;
    let loading = null;
    let timer;

    const selectedCategory = () => categoryOptions.find((option) => option.getAttribute('aria-selected') === 'true')?.dataset.value ?? '';
    const closeCategoryMenu = (restoreFocus = false) => {
      categoryMenu.hidden = true;
      categoryTrigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) categoryTrigger.focus();
    };
    const openCategoryMenu = () => {
      categoryMenu.hidden = false;
      categoryTrigger.setAttribute('aria-expanded', 'true');
      const selected = categoryOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? categoryOptions[0];
      categoryOptions.forEach((option) => { option.tabIndex = Number(option === selected); });
      selected?.focus();
    };
    const moveFocusOutsideCategoryDropdown = (reverse) => {
      const selector = 'a[href], button, input, select, textarea, summary, [tabindex], [contenteditable="true"]';
      const stops = [...document.querySelectorAll(selector)].filter((element) =>
        element instanceof HTMLElement &&
        element.tabIndex >= 0 &&
        !element.matches(':disabled') &&
        !element.closest('[hidden]') &&
        getComputedStyle(element).visibility !== 'hidden' &&
        element.getClientRects().length > 0,
      );
      const inside = stops.flatMap((element, index) => categoryDropdown.contains(element) ? [index] : []);
      const boundary = reverse ? Math.min(...inside) - 1 : Math.max(...inside) + 1;
      const destination = stops[boundary];

      closeCategoryMenu();
      if (destination) destination.focus();
      else if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    };
    const chooseCategory = (option) => {
      categoryOptions.forEach((item) => {
        const selected = item === option;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = Number(selected);
      });
      categoryValue.textContent = option.dataset.label ?? '全部分类';
      categoryTrigger.setAttribute('aria-label', `按分类筛选，当前${categoryValue.textContent}`);
      closeCategoryMenu(true);
      schedule();
    };

    const load = () => {
      loading ||= (async () => {
        try {
          pagefind = await import('/pagefind/pagefind.js');
          await pagefind.options({ excerptLength: 28, bundlePath: '/pagefind/' });
        } catch {
          status.textContent = '搜索索引尚未生成：请先执行 npm run build。';
        }
      })();
      return loading;
    };

    const render = async () => {
      const query = input.value.trim();
      const category = selectedCategory();
      if (!query && !category) {
        list.replaceChildren();
        status.textContent = '输入关键词或选择分类、标签开始搜索。';
        return;
      }

      if (!query && category) {
        const matches = [...catalog.querySelectorAll('li')]
          .filter((item) => item.dataset.category === category);
        renderItems(matches.map((item) => {
          const link = item.querySelector('a');
          return {
            url: link.href,
            title: link.dataset.title,
            excerpt: link.dataset.description,
            excerptHtml: false,
          };
        }), category);
        return;
      }

      await load();
      if (!pagefind) return;

      try {
        const filters = {
          ...(category ? { category: [category] } : {}),
        };
        const options = Object.keys(filters).length ? { filters } : {};
        const search = await pagefind.search(query, options);
        const items = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));
        renderItems(items, category, search.results.length);
      } catch {
        status.textContent = '搜索暂时不可用，请刷新页面后重试。';
      }
    };

    const renderItems = (items, selectedCategory, total = items.length) => {
      list.replaceChildren();
      if (items.length === 0) {
        status.textContent = '没有找到匹配的文章。';
        return;
      }
      status.textContent = `找到 ${total} 篇${selectedCategory ? `（分类「${selectedCategory}」）` : ''}文章`;
      for (const item of items) {
        const li = document.createElement('li');
        li.className = 'ledger-row';
        li.style.gridTemplateColumns = '1fr';

        const link = document.createElement('a');
        link.href = item.url;
        link.className = 'ledger-title';

        const title = document.createElement('span');
        title.className = 'block';
        title.textContent = item.title || (item.meta && item.meta.title) || item.url;

        const excerpt = document.createElement('span');
        excerpt.className = 'mt-1 block text-sm leading-relaxed text-fg-muted';
        if (item.excerptHtml === false) {
          excerpt.textContent = item.excerpt || '';
        } else {
          // Pagefind excerpt 已转义用户内容，只包含它自己的 <mark> 高亮标签。
          excerpt.innerHTML = item.excerpt || '';
        }

        link.append(title, excerpt);
        li.append(link);
        list.append(li);
      }
    };

    const schedule = () => {
      clearTimeout(timer);
      timer = setTimeout(() => void render(), 160);
    };
    input.addEventListener('input', schedule);
    categoryTrigger.addEventListener('click', () => {
      if (categoryMenu.hidden) openCategoryMenu();
      else closeCategoryMenu();
    });
    categoryOptions.forEach((option, index) => {
      option.addEventListener('click', () => chooseCategory(option));
      option.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowDown') next = (index + 1) % categoryOptions.length;
        else if (event.key === 'ArrowUp') next = (index - 1 + categoryOptions.length) % categoryOptions.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = categoryOptions.length - 1;
        else if (event.key === 'Escape') {
          event.preventDefault();
          closeCategoryMenu(true);
          return;
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          chooseCategory(option);
          return;
        } else if (event.key === 'Tab') {
          event.preventDefault();
          moveFocusOutsideCategoryDropdown(event.shiftKey);
          return;
        } else return;

        event.preventDefault();
        const nextOption = categoryOptions[next];
        categoryOptions.forEach((item) => { item.tabIndex = Number(item === nextOption); });
        nextOption?.focus();
      });
    });
    categoryTrigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openCategoryMenu();
      } else if (event.key === 'Escape' && !categoryMenu.hidden) {
        event.preventDefault();
        closeCategoryMenu(true);
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!categoryDropdown.contains(event.target)) {
        closeCategoryMenu(categoryMenu.contains(document.activeElement));
      }
    });
    categoryDropdown.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !categoryDropdown.contains(event.relatedTarget)) {
        closeCategoryMenu();
      }
    });

    window.addEventListener('keydown', (event) => {
      const target = event.target;
      const editing = target instanceof HTMLElement && (
        target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) ||
        target.closest('[aria-haspopup="listbox"], [role="listbox"], [role="option"]') !== null
      );
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        input.focus();
        input.select();
      } else if (event.key === '/' && !editing && !event.altKey && !event.ctrlKey && !event.metaKey) {
        event.preventDefault();
        input.focus();
      } else if (event.key === 'Escape' && document.activeElement === input) {
        if (input.value) {
          input.value = '';
          schedule();
        } else {
          input.blur();
        }
      }
    });
  }
</script>
