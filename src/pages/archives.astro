---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByYear } from '../lib/utils';

const posts = await getPublishedPosts();
const byYear = groupByYear(posts);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="归档" description={`按时间线浏览全部 ${posts.length} 篇文章`}>
  <div class="page-head">
    <h1 class="page-title">归档</h1>
    <p class="page-sub">共 <span class="num">{posts.length}</span> 篇</p>
  </div>

  <div class="space-y-12">
    {
      byYear.map(([year, items]) => (
        <section>
          <p class="section-label">{year}</p>
          <ul class="ledger">
            {items.map((post) => (
              <li class="ledger-row">
                <span class="ledger-id" />
                <span class="ledger-date">
                  {pad(post.data.pubDate.getMonth() + 1)}-
                  {pad(post.data.pubDate.getDate())}
                </span>
                <a href={`/blog/${post.id}/`} class="ledger-title">
                  {post.data.title}
                </a>
                <span />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
