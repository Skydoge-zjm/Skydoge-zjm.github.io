---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { getPublishedPosts } from '../lib/utils';
import { PROJECTS } from '../data/projects';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <section class="home-hero graph-paper">
    <div class="hero-topline rise rise-1">
      <p class="hero-kicker"><span class="prompt">$</span> journal</p>
      <span class="hero-folio">技术 · 工具 · 随想</span>
    </div>
    <h1 class="hero-title rise rise-2"><span class="hero-name">Skydoge</span><span>的笔记</span></h1>
    <p class="hero-lede rise rise-3">
      {SITE.name} 的技术笔记、踩坑记录，偶尔胡思乱想。把值得回头看的东西，慢慢写下来。
    </p>
    <div class="home-hero-links rise rise-4">
      <a href="/blog/" class="text-action">浏览文章 <span aria-hidden="true">→</span></a>
      <a href="/about/" class="text-action">关于我 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="home-section" aria-labelledby="recent-title">
        <div class="home-section-head">
          <h2 class="section-label" id="recent-title">最近写下</h2>
          <a href="/blog/" class="section-action">全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ledger">
          {posts.slice(0, SITE.homePostCount).map((post, index) => <PostCard post={post} featured={index === 0} headingLevel="h3" />)}
        </ul>
      </section>
    )
  }

  {PROJECTS.length > 0 && <section class="home-section" aria-labelledby="projects-title">
    <div class="home-section-head">
      <h2 class="section-label" id="projects-title">做过的东西</h2>
    </div>
        <div class="project-list">
          {PROJECTS.map((project) => (
            <article class="project-item">
              <a href={project.href} class="project-media" aria-label={`打开项目：${project.name}`}>
                <img src={project.image} alt={project.imageAlt} width={project.imageWidth} height={project.imageHeight} loading="lazy" decoding="async" />
              </a>
              <div class="project-copy">
                <div class="project-meta">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <h3 class="project-name"><a href={project.href}>{project.name}</a></h3>
                <p class="project-description">{project.description}</p>
                <div class="project-links">
                  <a href={project.href} class="text-action">阅读使用指南 <span aria-hidden="true">→</span></a>
                  {project.source && <a href={project.source} class="text-action" target="_blank" rel="noopener noreferrer">源代码 <span aria-hidden="true">↗</span></a>}
                </div>
              </div>
            </article>
          ))}
        </div>
  </section>}
</BaseLayout>
