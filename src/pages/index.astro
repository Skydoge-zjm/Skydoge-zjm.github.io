---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Tag from '../components/Tag.astro';
import { SITE } from '../consts';
import { getPublishedPosts } from '../lib/utils';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
---

<BaseLayout>
  <section class="graph-paper">
    <p class="hero-kicker rise rise-1">
      <span class="prompt">$</span> whoami
    </p>
    <h1 class="hero-title rise rise-2">你好，我是 {SITE.name}。</h1>
    <p class="hero-lede rise rise-3">
      这里是我的写字地方：技术笔记、踩坑记录，偶尔胡思乱想。
      更新随缘，但每一篇都是自己会回头再看的那种。
    </p>
  </section>

  {
    featured && (
      <section class="mt-14">
        <p class="section-label">最新</p>
        <a href={`/blog/${featured.id}/`} class="feature rise rise-4">
          <span class="feature-meta">
            <span>
              {featured.data.pubDate.getFullYear()}-
              {String(featured.data.pubDate.getMonth() + 1).padStart(2, '0')}-
              {String(featured.data.pubDate.getDate()).padStart(2, '0')}
            </span>
            {featured.data.pinned && <span>置顶</span>}
          </span>
          <span class="feature-title block">{featured.data.title}</span>
          <span class="feature-desc block">{featured.data.description}</span>
          {
            featured.data.tags.length > 0 && (
              <span class="mt-3 flex flex-wrap gap-1.5">
                {featured.data.tags.map((tag) => (
                  <Tag tag={tag} />
                ))}
              </span>
            )
          }
        </a>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="mt-14">
        <p class="section-label">全部</p>
        <ul class="ledger">
          {rest.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
