---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import avatar from '../assets/skydoge-avatar.jpg';
import manuscript from '../assets/writing/markdown-showcase.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_INTRO, SITE } from '../consts';
import { formatDate, getPublishedPosts } from '../lib/utils';
import '../styles/home.css';

const posts = (await getPublishedPosts()).slice(0, SITE.homePostCount);
// 与文章同名的插画优先，新文章可直接使用通用稿纸插画。
const illustrations = import.meta.glob<ImageMetadata>('../assets/writing/*.webp', {
  eager: true,
  import: 'default',
});
---

<BaseLayout wide>
  <section class="home-profile" aria-labelledby="profile-name">
    <div class="profile-identity">
      <Image src={avatar} alt="" width={72} height={72} densities={[1, 2, 3]} loading="eager" class="profile-avatar" />
      <h1 id="profile-name" lang="en">{SITE.name}</h1>
    </div>
    <p class="profile-bio">{AUTHOR_INTRO.map((sentence) => <span>{sentence}</span>)}</p>
    <nav class="profile-links" aria-label="作者信息">
      <a href="/about/">关于我 <span aria-hidden="true">→</span></a>
      <a href={SITE.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="profile-drawing" aria-hidden="true"></div>
  </section>

  <section class="home-writing" aria-labelledby="writing-title">
    <header class="writing-head">
      <h2 id="writing-title">近期文章</h2>
      <a href="/blog/">全部文章 <span aria-hidden="true">→</span></a>
    </header>
    {posts.length > 0 ? (
      <ul class="writing-grid">
        {posts.map((post) => {
          const art = illustrations[`../assets/writing/${post.id}.webp`] ?? manuscript;
          return (
            <li>
              <a class="writing-link" href={`/blog/${post.id}/`}>
                <img class="writing-art" src={art.src} width={art.width} height={art.height} alt="" decoding="async" />
                <h3>{post.data.title}{post.data.pinned && <span class="ledger-pin">置顶</span>}</h3>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              </a>
            </li>
          );
        })}
      </ul>
    ) : <p class="empty-note">还没有已发布的文章。</p>}
  </section>
</BaseLayout>
