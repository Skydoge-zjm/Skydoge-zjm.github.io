---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/utils';

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return [...getTagCounts(posts).keys()].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
};

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签「${tag}」下的 ${posts.length} 篇文章`}>
  <div class="page-head">
    <a href="/tags" class="rail-text-link">← 所有标签</a>
    <h1 class="page-title mt-3">#{tag}</h1>
    <p class="page-sub"><span class="num">{posts.length}</span> 篇</p>
  </div>

  <ul class="ledger">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
