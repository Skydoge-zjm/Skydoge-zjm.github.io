---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/utils';

const posts = await getPublishedPosts();
const tagCounts = getTagCounts(posts);
---

<BaseLayout title="标签" description={`共 ${tagCounts.size} 个标签`}>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-2xl font-semibold tracking-tight">标签</h1>
    <p class="mt-2 text-sm text-fg-muted">共 {tagCounts.size} 个</p>

    <nav class="mt-8 flex flex-wrap gap-2" aria-label="全部标签">
      {
        [...tagCounts].map(([tag, count]) => (
          <a href={`/tags/${encodeURIComponent(tag)}`} class="chip px-3 py-1.5">
            #{tag}
            <span class="text-fg-faint">{count}</span>
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>
