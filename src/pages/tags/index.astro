---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/utils';

const posts = await getPublishedPosts();
const tagCounts = getTagCounts(posts);
---

<BaseLayout title="标签" description={`共 ${tagCounts.size} 个标签`}>
  <div class="page-head">
    <h1 class="page-title">标签</h1>
    <p class="page-sub">共 <span class="num">{tagCounts.size}</span> 个</p>
  </div>

  <nav class="flex flex-wrap gap-2" aria-label="全部标签">
    {
      [...tagCounts].map(([tag, count]) => (
        <a href={`/tags/${encodeURIComponent(tag)}`} class="chip px-2.5 py-1">
          #{tag}
          <span class="chip-count">{count}</span>
        </a>
      ))
    }
  </nav>
</BaseLayout>
