---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" noindex>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-32 text-center">
    <p class="font-mono text-6xl font-semibold tracking-tight text-accent">404</p>
    <h1 class="mt-6 text-xl font-medium">这里什么都没有</h1>
    <p class="mt-3 text-sm text-fg-muted">
      页面可能被移动或删除了。要不，回首页逛逛？
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg border border-border px-4 py-2 text-sm transition-colors hover:border-accent hover:text-accent"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
