---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" noindex>
  <div class="flex flex-col items-start py-24">
    <p class="font-display text-6xl font-medium text-accent">404</p>
    <h1 class="mt-6 text-xl font-medium">这里什么都没有</h1>
    <p class="mt-3 text-sm text-fg-muted">
      页面可能被移动或删除了。要不，回首页逛逛？
    </p>
    <a
      href="/"
      class="chip mt-8 px-3 py-1.5"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
